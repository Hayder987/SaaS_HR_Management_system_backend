model Payroll {
  id             String @id @default(uuid())
  organizationId String

  month Int
  year  Int

  status PayrollStatus @default(DRAFT)

  totalGross     Decimal @default(0)
  totalDeduction Decimal @default(0)
  totalNet       Decimal @default(0)

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items PayrollItem[]

  @@unique([organizationId, month, year])
  @@index([organizationId, year, month])
  @@map("payrolls")
}

model PayrollItem {
  id         String @id @default(uuid())
  payrollId  String
  employeeId String

  basicSalary Decimal
  allowance   Decimal @default(0)
  deduction   Decimal @default(0)

  grossSalary Decimal
  netSalary   Decimal

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@map("payroll_items")
}
