model User {
  id String @id @default(uuid()) @db.Uuid

  name String

  email String @unique

  password String?

  ImageUrl String?

  authMethod AuthMethod @default(CREDENTIALS)

  role UserRole @default(PLATFORM_USER)

  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)

  emailVerifiedAt DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingDeadline DateTime?

  memberships Membership[]

  ownedOrganizations Organization[]

  employees Employee[]

  leaveReviews EmployeeLeaveRequest[] @relation("LeaveReviewer")

  leaveApprovals LeaveApproval[] @relation("LeaveApprover")

  notifications Notification[]

  auditLogs AuditLog[]

  payments Payment[]

  @@index([email])
  @@index([status])
  @@index([role])
  @@index([authMethod])
  @@map("users")
}
