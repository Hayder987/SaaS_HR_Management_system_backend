model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String
  slug String @unique

  email   String
  phone   String?
  address String?

  logoUrl String? @default("")
  imagePublicId String? @default("")

  locationName String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  attendanceRadiusMeters Int @default(100)

  timezone String @default("Asia/Dhaka")
  currency String @default("USD")

  status OrganizationStatus @default(ACTIVE)

  ownerUserId String @db.Uuid

  storageUsedBytes Int @default(0)

  onboardingDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  memberships Membership[]
  employees   Employee[]

  departments  Department[]
  designations Designation[]

  subscription Subscription?

  workLocations WorkLocation[]
  shifts        Shift[]

  leaveTypes    LeaveType[]
  leaveRequests EmployeeLeaveRequest[]

  onboardingTemplates OnboardingTemplate[]
  documents           EmployeeDocument[]

  notifications  Notification[]
  automationLogs AutomationLog[]
  auditLogs      AuditLog[]

  googleIntegration GoogleIntegration?

  payments Payment[]

  @@index([ownerUserId])
  @@index([status])
  @@index([email])
  @@map("organizations")
}
