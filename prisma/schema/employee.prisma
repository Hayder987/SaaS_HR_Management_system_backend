model Employee {
  id             String @id @default(uuid())
  organizationId String

  userId String? @unique

  employeeCode String

  firstName String
  lastName  String?

  workEmail String
  phone     String?

  joiningDate DateTime

  employmentType EmploymentType
  status         EmployeeStatus @default(ACTIVE)

  departmentId  String?
  designationId String?

  // Self relation: manager → employees
  managerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  manager Employee? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)

  subordinates Employee[] @relation("EmployeeManager")

  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  salary        Salary?
  payrollItems  PayrollItem[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, designationId])
  @@index([managerId])
  @@map("employees")
}
