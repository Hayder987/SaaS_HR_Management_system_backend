<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />

    <title>Verify Your Email | HR Management</title>

    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #f3f6fa;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        color: #172033;
      }

      * {
        box-sizing: border-box;
      }

      body {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table {
        border-spacing: 0;
        border-collapse: collapse;
      }

      img {
        border: 0;
        display: block;
        max-width: 100%;
      }

      a {
        text-decoration: none;
      }

      /* ==============================
         EMAIL WRAPPER
      ============================== */

      .email-wrapper {
        width: 100%;
        background-color: #f3f6fa;
        padding: 48px 16px;
      }

      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e5eaf1;
        border-radius: 18px;
        overflow: hidden;
      }

      /* ==============================
         HEADER
      ============================== */

      .header {
        background-color: #111827;
        padding: 30px 40px;
      }

      .brand-table {
        width: 100%;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        background-color: #2563eb;
        border-radius: 10px;
        color: #ffffff;
        font-size: 19px;
        font-weight: 800;
        text-align: center;
        line-height: 42px;
      }

      .brand-name {
        padding-left: 12px;
        color: #ffffff;
        font-size: 18px;
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: -0.2px;
      }

      .brand-tagline {
        margin-top: 4px;
        color: #9ca3af;
        font-size: 11px;
        line-height: 1.4;
        letter-spacing: 0.2px;
      }

      /* ==============================
         CONTENT
      ============================== */

      .content {
        padding: 46px 48px 42px;
      }

      .security-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 24px;
        background-color: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 50%;
        text-align: center;
        line-height: 58px;
        font-size: 25px;
      }

      .eyebrow {
        margin: 0 0 9px;
        color: #2563eb;
        font-size: 11px;
        line-height: 1.4;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-align: center;
        text-transform: uppercase;
      }

      .title {
        margin: 0;
        color: #111827;
        font-size: 28px;
        line-height: 1.25;
        font-weight: 750;
        letter-spacing: -0.6px;
        text-align: center;
      }

      .description {
        max-width: 460px;
        margin: 16px auto 30px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.75;
        text-align: center;
      }

      .user-name {
        color: #334155;
        font-weight: 700;
      }

      /* ==============================
         OTP
      ============================== */

      .otp-label {
        margin: 0 0 9px;
        color: #64748b;
        font-size: 10px;
        line-height: 1.4;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-align: center;
        text-transform: uppercase;
      }

      .otp-card {
        width: 100%;
        margin: 0 auto 22px;
        padding: 25px 20px;
        background-color: #f8fbff;
        border: 1px solid #dbeafe;
        border-radius: 14px;
        text-align: center;
      }

      .otp {
        margin: 0;
        color: #1d4ed8;
        font-size: 36px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: 9px;
        padding-left: 9px;
      }

      .otp-helper {
        margin: 10px 0 0;
        color: #94a3b8;
        font-size: 11px;
        line-height: 1.5;
      }

      /* ==============================
         EXPIRY NOTICE
      ============================== */

      .expiry-card {
        width: 100%;
        margin-bottom: 26px;
        padding: 15px 18px;
        background-color: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 11px;
      }

      .expiry-icon {
        width: 24px;
        vertical-align: top;
        font-size: 15px;
        line-height: 1.5;
      }

      .expiry-text {
        padding-left: 8px;
        color: #92400e;
        font-size: 12px;
        line-height: 1.6;
      }

      .expiry-text strong {
        color: #78350f;
      }

      /* ==============================
         SECURITY NOTICE
      ============================== */

      .security-card {
        padding: 18px 20px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
      }

      .security-title {
        margin: 0 0 6px;
        color: #334155;
        font-size: 12px;
        line-height: 1.5;
        font-weight: 700;
      }

      .security-text {
        margin: 0;
        color: #64748b;
        font-size: 11px;
        line-height: 1.7;
      }

      /* ==============================
         FOOTER
      ============================== */

      .footer {
        padding: 28px 40px;
        background-color: #f8fafc;
        border-top: 1px solid #e5e7eb;
        text-align: center;
      }

      .footer-brand {
        margin: 0 0 8px;
        color: #334155;
        font-size: 12px;
        line-height: 1.5;
        font-weight: 700;
      }

      .footer-text {
        max-width: 420px;
        margin: 0 auto 12px;
        color: #94a3b8;
        font-size: 10px;
        line-height: 1.7;
      }

      .copyright {
        margin: 0;
        color: #cbd5e1;
        font-size: 10px;
        line-height: 1.5;
      }

      /* ==============================
         MOBILE
      ============================== */

      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 10px;
        }

        .header {
          padding: 24px 22px;
        }

        .content {
          padding: 36px 22px 32px;
        }

        .footer {
          padding: 24px 20px;
        }

        .title {
          font-size: 24px;
        }

        .description {
          font-size: 13px;
        }

        .otp {
          font-size: 31px;
          letter-spacing: 7px;
        }
      }
    </style>
  </head>

  <body>
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="width: 100%; background-color: #f3f6fa"
    >
      <tr>
        <td align="center">
          <div class="email-wrapper">
            <table
              role="presentation"
              class="email-container"
              width="600"
              cellpadding="0"
              cellspacing="0"
              border="0"
            >
              <!-- =========================
                   HEADER
              ========================== -->

              <tr>
                <td class="header">
                  <table
                    role="presentation"
                    class="brand-table"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                  >
                    <tr>
                      <td width="42">
                        <div class="brand-mark">HR</div>
                      </td>

                      <td class="brand-name">
                        HR Management

                        <div class="brand-tagline">
                          Modern Workforce Management Platform
                        </div>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- =========================
                   MAIN CONTENT
              ========================== -->

              <tr>
                <td class="content">
                  <!-- Verification Icon -->

                  <div class="security-icon">✉️</div>

                  <!-- Heading -->

                  <p class="eyebrow">Email Verification</p>

                  <h1 class="title">Verify your email address</h1>

                  <!-- Description -->

                  <p class="description">
                    Hello
                    <span class="user-name"><%= name %></span>, welcome to HR
                    Management. Please use the verification code below to verify
                    your email address and activate your account.
                  </p>

                  <!-- OTP -->

                  <p class="otp-label">Verification Code</p>

                  <div class="otp-card">
                    <p class="otp"><%= otp %></p>

                    <p class="otp-helper">
                      Enter this code in your HR Management application to
                      verify your email address.
                    </p>
                  </div>

                  <!-- Expiration -->

                  <table
                    role="presentation"
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    class="expiry-card"
                  >
                    <tr>
                      <td class="expiry-icon">⏱</td>

                      <td class="expiry-text">
                        This verification code expires in
                        <strong> <%= expirationMinutes %> minutes </strong>. For
                        your security, do not share this code with anyone.
                      </td>
                    </tr>
                  </table>

                  <!-- Security Notice -->

                  <div class="security-card">
                    <p class="security-title">
                      🛡️ Didn't request this verification code?
                    </p>

                    <p class="security-text">
                      You can safely ignore this email. No changes will be made
                      to your account unless the verification process is
                      successfully completed.
                    </p>
                  </div>
                </td>
              </tr>

              <!-- =========================
                   FOOTER
              ========================== -->

              <tr>
                <td class="footer">
                  <p class="footer-brand">HR Management</p>

                  <p class="footer-text">
                    This is an automated account verification email. Please do
                    not reply to this email.
                  </p>

                  <p class="copyright">
                    &copy; <%= new Date().getFullYear() %> HR Management. All
                    rights reserved.
                  </p>
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
