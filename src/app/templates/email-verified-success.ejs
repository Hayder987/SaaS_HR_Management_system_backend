<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />

    <title>Registration & Email Verification Successful | HR Management</title>

    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #f3f6fa;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        color: #172033;
      }

      * {
        box-sizing: border-box;
      }

      body {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table {
        border-spacing: 0;
        border-collapse: collapse;
      }

      img {
        border: 0;
        display: block;
        max-width: 100%;
      }

      a {
        text-decoration: none;
      }

      /* ==============================
         EMAIL WRAPPER
      ============================== */

      .email-wrapper {
        width: 100%;
        background-color: #f3f6fa;
        padding: 48px 16px;
      }

      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e5eaf1;
        border-radius: 18px;
        overflow: hidden;
      }

      /* ==============================
         HEADER
      ============================== */

      .header {
        background-color: #111827;
        padding: 30px 40px;
      }

      .brand-table {
        width: 100%;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        background-color: #2563eb;
        border-radius: 10px;
        color: #ffffff;
        font-size: 19px;
        font-weight: 800;
        text-align: center;
        line-height: 42px;
      }

      .brand-name {
        padding-left: 12px;
        color: #ffffff;
        font-size: 18px;
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: -0.2px;
      }

      .brand-tagline {
        margin-top: 4px;
        color: #9ca3af;
        font-size: 11px;
        line-height: 1.4;
        letter-spacing: 0.2px;
      }

      /* ==============================
         CONTENT
      ============================== */

      .content {
        padding: 46px 48px 42px;
        text-align: center;
      }

      /* ==============================
         SUCCESS ICON
      ============================== */

      .success-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 24px;
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        border-radius: 50%;
        color: #059669;
        font-size: 30px;
        font-weight: 700;
        line-height: 62px;
        text-align: center;
      }

      /* ==============================
         HEADING
      ============================== */

      .eyebrow {
        margin: 0 0 9px;
        color: #059669;
        font-size: 11px;
        line-height: 1.4;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-align: center;
        text-transform: uppercase;
      }

      .title {
        margin: 0;
        color: #111827;
        font-size: 28px;
        line-height: 1.25;
        font-weight: 750;
        letter-spacing: -0.6px;
        text-align: center;
      }

      .description {
        max-width: 460px;
        margin: 16px auto 30px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.75;
        text-align: center;
      }

      .user-name {
        color: #334155;
        font-weight: 700;
      }

      /* ==============================
         SUCCESS CARD
      ============================== */

      .success-card {
        width: 100%;
        margin: 0 auto 24px;
        padding: 22px 20px;
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 14px;
        text-align: center;
      }

      .success-card-title {
        margin: 0 0 7px;
        color: #166534;
        font-size: 14px;
        line-height: 1.5;
        font-weight: 700;
      }

      .success-card-text {
        margin: 0;
        color: #4d7c0f;
        font-size: 12px;
        line-height: 1.7;
      }

      /* ==============================
         ACCOUNT STATUS
      ============================== */

      .status-card {
        width: 100%;
        margin-bottom: 24px;
        padding: 16px 18px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
      }

      .status-icon {
        width: 28px;
        vertical-align: middle;
        font-size: 16px;
      }

      .status-text {
        padding-left: 8px;
        color: #475569;
        font-size: 12px;
        line-height: 1.6;
        text-align: left;
      }

      .status-text strong {
        color: #334155;
      }

      /* ==============================
         SECURITY NOTICE
      ============================== */

      .security-card {
        padding: 18px 20px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        text-align: left;
      }

      .security-title {
        margin: 0 0 6px;
        color: #334155;
        font-size: 12px;
        line-height: 1.5;
        font-weight: 700;
      }

      .security-text {
        margin: 0;
        color: #64748b;
        font-size: 11px;
        line-height: 1.7;
      }

      /* ==============================
         FOOTER
      ============================== */

      .footer {
        padding: 28px 40px;
        background-color: #f8fafc;
        border-top: 1px solid #e5e7eb;
        text-align: center;
      }

      .footer-brand {
        margin: 0 0 8px;
        color: #334155;
        font-size: 12px;
        line-height: 1.5;
        font-weight: 700;
      }

      .footer-text {
        max-width: 420px;
        margin: 0 auto 12px;
        color: #94a3b8;
        font-size: 10px;
        line-height: 1.7;
      }

      .copyright {
        margin: 0;
        color: #cbd5e1;
        font-size: 10px;
        line-height: 1.5;
      }

      /* ==============================
         MOBILE
      ============================== */

      @media only screen and (max-width: 600px) {
        .email-wrapper {
          padding: 20px 10px;
        }

        .header {
          padding: 24px 22px;
        }

        .content {
          padding: 36px 22px 32px;
        }

        .footer {
          padding: 24px 20px;
        }

        .title {
          font-size: 24px;
        }

        .description {
          font-size: 13px;
        }

        .success-icon {
          width: 58px;
          height: 58px;
          font-size: 27px;
          line-height: 56px;
        }
      }
    </style>
  </head>

  <body>
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="width: 100%; background-color: #f3f6fa"
    >
      <tr>
        <td align="center">
          <div class="email-wrapper">
            <table
              role="presentation"
              class="email-container"
              width="600"
              cellpadding="0"
              cellspacing="0"
              border="0"
            >
              <!-- =========================
                   HEADER
              ========================== -->

              <tr>
                <td class="header">
                  <table
                    role="presentation"
                    class="brand-table"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                  >
                    <tr>
                      <td width="42">
                        <div class="brand-mark">HR</div>
                      </td>

                      <td class="brand-name">
                        HR Management

                        <div class="brand-tagline">
                          Modern Workforce Management Platform
                        </div>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- =========================
                   MAIN CONTENT
              ========================== -->

              <tr>
                <td class="content">
                  <!-- Success Icon -->

                  <div class="success-icon">✓</div>

                  <!-- Heading -->

                  <p class="eyebrow">Registration Complete</p>

                  <h1 class="title">Welcome to HR Management</h1>

                  <!-- Description -->

                  <p class="description">
                    Hello
                    <span class="user-name"><%= name %></span>, your
                    registration and email verification have been completed
                    successfully. Your HR Management account is now ready to
                    use.
                  </p>

                  <!-- Success Card -->

                  <div class="success-card">
                    <p class="success-card-title">🎉 Registration successful</p>

                    <p class="success-card-text">
                      Your account has been created and your email address has
                      been successfully verified. You can now securely access
                      your HR Management account.
                    </p>
                  </div>

                  <!-- Account Status -->

                  <table
                    role="presentation"
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    border="0"
                    class="status-card"
                  >
                    <tr>
                      <td class="status-icon">✓</td>

                      <td class="status-text">
                        <strong>Account Status:</strong>
                        Registration and email verification completed
                        successfully.
                      </td>
                    </tr>
                  </table>

                  <!-- Security Notice -->

                  <div class="security-card">
                    <p class="security-title">🛡️ Keep your account secure</p>

                    <p class="security-text">
                      Never share your password, verification codes, or account
                      credentials with anyone. If you notice any suspicious
                      activity, please secure your account immediately.
                    </p>
                  </div>
                </td>
              </tr>

              <!-- =========================
                   FOOTER
              ========================== -->

              <tr>
                <td class="footer">
                  <p class="footer-brand">HR Management</p>

                  <p class="footer-text">
                    This is an automated account notification. Please do not
                    reply to this email.
                  </p>

                  <p class="copyright">
                    &copy; <%= new Date().getFullYear() %> HR Management. All
                    rights reserved.
                  </p>
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
